{
  "hooks": {
    "Stop": [
      {
        "matcher": "Resume_Executif",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[hook] Executive summary generated — Claude will send email via Gmail MCP next session.'"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_FLOW_V3_ENABLED": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true"
  },
  "permissions": {
    "allow": [
      "Bash(npx @claude-flow*)",
      "Bash(npx claude-flow*)",
      "Bash(node .claude/*)",
      "mcp__claude-flow__*"
    ]
  }
}