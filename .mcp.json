{
  "mcpServers": {
    "gmail": {
      "command": "npx",
      "args": [
        "-y",
        "@gongrzhe/server-gmail-autoauth-mcp"
      ]
    },
    "perplexity": {
      "command": "npx",
      "args": [
        "-y",
        "@perplexity-ai/mcp-server"
      ],
      "env": {
        "PERPLEXITY_API_KEY": "YOUR_PERPLEXITY_API_KEY_HERE"
      }
    },
    "skillspector": {
      "command": "skillspector",
      "args": [
        "mcp"
      ]
    },
    "headroom": {
      "command": "headroom",
      "args": [
        "mcp",
        "serve"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "composio": {
      "command": "npx",
      "args": [
        "-y",
        "@composio/mcp@latest"
      ],
      "env": {
        "COMPOSIO_API_KEY": "YOUR_COMPOSIO_API_KEY_HERE"
      }
    },
    "chatplace": {
      "type": "url",
      "url": "https://mcp.chatplace.io/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_CHATPLACE_API_KEY_HERE"
      }
    },
    "outstand-instagram": {
      "type": "url",
      "url": "https://mcp.outstand.so/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_OUTSTAND_API_KEY_HERE"
      }
    },
    "porter-instagram": {
      "type": "url",
      "url": "https://mcp.portermetrics.com/mcp"
    }
  }
}
