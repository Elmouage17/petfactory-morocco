# Postiz App Configuration
# Copy this file to .env and update values as needed
# See https://docs.postiz.com for full documentation

# Main URLs - change to your domain in production
MAIN_URL=http://localhost:4200
FRONTEND_URL=http://localhost:4200
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postiz:postiz_password@localhost:5432/postiz
DIRECT_URL=postgresql://postiz:postiz_password@localhost:5432/postiz

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secret - CHANGE THIS to a random string
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# Upload directory
UPLOAD_DIRECTORY=/tmp/postiz-uploads
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=/tmp/postiz-uploads

# Storage (local by default)
STORAGE_PROVIDER=local

# General settings
IS_GENERAL=true
NX_ADD_PLUGINS=false

# Backend internal URL
BACKEND_INTERNAL_URL=http://localhost:3000
